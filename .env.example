# Phaze Web Bridge configuration
# Copy this file to .env on the Windows 11 or macOS computer running Phaze.

# Port & bind host for the web bridge server
PORT=8787
HOST=0.0.0.0

# Local Phaze desktop app MCP HTTP endpoint (enable "MCP server" in Phaze -> Settings -> Experimental)
PHAZE_MCP_URL=http://127.0.0.1:41010/mcp

# Optional: Phaze Enterprise API key (from https://dashboard.phaze.app/settings)
# Enriches workstations with OS, owner/assignee, org groups, and connection logs.
PHAZE_API_KEY=

# Optional: Protect this Web Bridge with a passcode before exposing via Cloudflare Tunnel / Tailscale / ngrok
BRIDGE_PASSCODE=

# Mode: "auto" (uses Live Phaze MCP when reachable, falls back to Interactive Simulator), "live", or "simulator"
BRIDGE_MODE=auto
